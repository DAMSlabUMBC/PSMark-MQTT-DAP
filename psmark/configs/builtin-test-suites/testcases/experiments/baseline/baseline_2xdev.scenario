[
    {name, baseline_2xdev},
    {duration, {60, seconds}},
    {protocol, mqttv5},
    {deployment_name, smart_factory_2x_1_node},
    {hosts,
    [
        {runner1, [{hostname, "127.0.0.1"}]}
    ]},

    {protocol_config,
    [
        {broker, "127.0.0.1"},
        {port, 18884},
        {qos,
        [
            {default_qos, 0}
        ]}
    ]},

    {metric_config,
    [
        {output_dir, "results"},
        {hw_stats_poll_period_ms, 1000},
        {metric_plugins,
        [
            {ps_bench_throughput_calc_plugin, erlang},
            {ps_bench_latency_calc_plugin, erlang},
            {ps_bench_dropped_message_calc_plugin, erlang}
        ]}
    ]}
].
