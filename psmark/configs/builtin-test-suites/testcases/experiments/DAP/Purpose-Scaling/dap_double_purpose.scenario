[
    {name, dap_double_purpose},
    {duration, {60, seconds}},
    {protocol, mqttv5},
    {deployment_name, floor_40x1},
    {hosts,
    [
        {floor1,                     [{hostname, "127.0.0.1"}]},
        {sub_quality_assurance,      [{hostname, "127.0.0.1"}]},
        {sub_maintenance_predictive, [{hostname, "127.0.0.1"}]},
        {sub_maintenance_routine,    [{hostname, "127.0.0.1"}]},
        {sub_operations_forecast,    [{hostname, "127.0.0.1"}]},
        {sub_regulatory_reporting,   [{hostname, "127.0.0.1"}]},
        {sub_vendor_maintenance,     [{hostname, "127.0.0.1"}]}
    ]},

    {protocol_config,
    [
        {client_interface_module, ps_bench_dap_mqtt_interface},
        {broker, "127.0.0.1"},
        {port, 18883},
        {qos,
        [
            {default_qos, 0}
        ]},
        {device_purposes,
        [
            {machine_temperature_sensor, ["quality/assurance/{1,2}"]},
            {machine_speed_sensor,       ["maintenance/{predictive,routine}/{1,2}"]},
            {machine_energy_consumption, ["operations/forecast/{1,2}","regulatory/reporting/{1,2}"]},
            {production_quality_sensor,  ["quality/assurance/{1,2}","operations/forecast/{1,2}","regulatory/reporting/{1,2}"]},
            {vibration_sensor,           ["quality/assurance/{1,2}","maintenance/{predictive,routine}/{1,2}"]},
            {robot_farmap,               ["vendor/maintenance/{1,2}"]},
            {robot_nearmap,              ["vendor/maintenance/{1,2}"]},
            {robot_imu,                  ["vendor/maintenance/{1,2}"]},
            {robot_lidar,                ["vendor/maintenance/{1,2}"]},
            {robot_odometry,             ["vendor/maintenance/{1,2}"]}
        ]},
        %% One subscriber per purpose; the brace suffix mirrors the MP variant
        %% suffix above (the broker expands SP braces at SUBSCRIBE), so each
        %% subscriber covers ALL variants of its purpose - the broker matches
        %% exact tokens, so a plain SP would match nothing at 2x.
        {node_subscription_purposes,
        [
            {sub_quality_assurance,      "quality/assurance/{1,2}"},
            {sub_maintenance_predictive, "maintenance/predictive/{1,2}"},
            {sub_maintenance_routine,    "maintenance/routine/{1,2}"},
            {sub_operations_forecast,    "operations/forecast/{1,2}"},
            {sub_regulatory_reporting,   "regulatory/reporting/{1,2}"},
            {sub_vendor_maintenance,     "vendor/maintenance/{1,2}"}
        ]}
    ]},

    {metric_config,
    [
        {output_dir, "results"},
        {hw_stats_poll_period_ms, 1000},
        {metric_plugins,
        [
            {ps_bench_throughput_calc_plugin, erlang},
            {ps_bench_latency_calc_plugin, erlang},
            {ps_bench_dropped_message_calc_plugin, erlang}
        ]}
    ]}
].
