% Floors x devices cell scenario: 40 devices x 1 floor (+ subscriber-only node).
[
    {name, floor_40x1},
    {duration, {60, seconds}},
    {protocol, mqttv5},
    {deployment_name, floor_40x1},
    {hosts,
    [
        {floor1,     [{hostname, "127.0.0.1"}]},
        {aggregator, [{hostname, "127.0.0.1"}]}
    ]},

    {protocol_config,
    [
        {client_interface_module, ps_bench_dap_mqtt_interface},
        {broker, "127.0.0.1"},
        {port, 1883},
        {qos, [{default_qos, 0}]},
        {device_purposes,
        [
            {floor_sensor, "maintenance/predictive"}
        ]}
    ]},

    {metric_config,
    [
        {output_dir, "results"},
        {hw_stats_poll_period_ms, 1000},
        {metric_plugins, [{ps_bench_throughput_calc_plugin, erlang}]}
    ]}
].
