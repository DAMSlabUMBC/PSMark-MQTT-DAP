[
    {name, dap_scale_40p_1n},
    {duration, {3, minutes}},
    {protocol, mqttv5},
    {deployment_name, dap_scale_40p_1n},
    {hosts,
    [
        {runner1,
        [
            {hostname, "127.0.0.1"}
        ]}
    ]},

    {protocol_config,
    [
        {client_interface_module, ps_bench_dap_mqtt_interface},
        {broker, "127.0.0.1"},
        {port, 1883},
        {qos,
        [
            {default_qos, 0}
        ]}
    ]},

    {metric_config,
    [
        {output_dir, "results"},
        {hw_stats_poll_period_ms, 1000},
        {metric_plugins,
        [
            {ps_bench_throughput_calc_plugin, erlang},
            {ps_bench_latency_calc_plugin, erlang},
            {ps_bench_dropped_message_calc_plugin, erlang}
        ]}
    ]}
].
