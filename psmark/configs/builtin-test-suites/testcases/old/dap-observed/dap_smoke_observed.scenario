[
    {name, dap_smoke_observed},
    {duration, {30, seconds}},
    {protocol, mqttv5},
    {deployment_name, dap_smoke},
    {hosts,
    [
        {runner1, [{hostname, "127.0.0.1"}]}
    ]},

    {protocol_config,
    [
        {client_interface_module, ps_bench_dap_mqtt_interface},
        {broker, "127.0.0.1"},
        {port, 1883},
        {qos,
        [
            {default_qos, 0}
        ]},
        {device_purposes,
        [
            {machine_energy_consumption, "finance.reporting"}
        ]}
    ]},

    {metric_config,
    [
        {output_dir, "results"},
        {metric_plugins,
        [
            {ps_bench_throughput_calc_plugin, erlang},
            {ps_bench_latency_calc_plugin, erlang},
            {ps_bench_dropped_message_calc_plugin, erlang}
        ]}
    ]}
].
