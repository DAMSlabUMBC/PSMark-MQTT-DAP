% Matrix cell topology: 80 devices x 2 floors (paper SS7.3 scalings).
% Doubled smart-factory device mix on EACH of two floor nodes (matches the
% smart_factory_2x_2_node convention); six subscriber-only consumer nodes, one
% per purpose, consume across floors (DAP-SP wired per scenario).
[
    {name, floor_80x2},
    {nodes,
    [
        {floor1,
        [
            {devices,
            [
                {machine_temperature_sensor, 12},
                {machine_speed_sensor, 12},
                {machine_energy_consumption, 12},
                {production_quality_sensor, 12},
                {vibration_sensor, 12},
                {robot_farmap, 4},
                {robot_nearmap, 4},
                {robot_imu, 4},
                {robot_lidar, 4},
                {robot_odometry, 4}
            ]}
        ]},
        {floor2,
        [
            {devices,
            [
                {machine_temperature_sensor, 12},
                {machine_speed_sensor, 12},
                {machine_energy_consumption, 12},
                {production_quality_sensor, 12},
                {vibration_sensor, 12},
                {robot_farmap, 4},
                {robot_nearmap, 4},
                {robot_imu, 4},
                {robot_lidar, 4},
                {robot_odometry, 4}
            ]}
        ]},
        {sub_quality_assurance,     [{role, subscriber}, {devices, []}]},
        {sub_maintenance_predictive,[{role, subscriber}, {devices, []}]},
        {sub_maintenance_routine,   [{role, subscriber}, {devices, []}]},
        {sub_operations_forecast,   [{role, subscriber}, {devices, []}]},
        {sub_regulatory_reporting,  [{role, subscriber}, {devices, []}]},
        {sub_vendor_maintenance,    [{role, subscriber}, {devices, []}]}
    ]}
].
