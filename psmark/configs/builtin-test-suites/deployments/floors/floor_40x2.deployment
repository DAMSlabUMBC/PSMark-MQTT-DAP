% Floors x devices topology cell: 40 devices x 2 floors.
% A floor = an edge server = a node. Each floor node runs 40 publisher devices;
% a single subscriber-only node (role subscriber) consumes across both floors.
[
    {name, floor_40x2},
    {nodes,
    [
        {floor1,
        [
            {devices,
            [
                {floor_sensor, 40}
            ]}
        ]},
        {floor2,
        [
            {devices,
            [
                {floor_sensor, 40}
            ]}
        ]},
        {aggregator,
        [
            {role, subscriber},
            {devices, []}
        ]}
    ]}
].
