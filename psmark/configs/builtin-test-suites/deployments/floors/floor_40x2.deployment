% Matrix cell topology: 40 devices x 2 floors (paper SS7.3 scalings).
% The full smart-factory device mix on EACH of two floor nodes (matches the
% smart_factory_2_node convention); six subscriber-only consumer nodes, one per
% purpose, consume across floors (DAP-SP wired per scenario).
[
    {name, floor_40x2},
    {nodes,
    [
        {floor1,
        [
            {role, publisher_only},
            {devices,
            [
                {machine_temperature_sensor, 6},
                {machine_speed_sensor, 6},
                {machine_energy_consumption, 6},
                {production_quality_sensor, 6},
                {vibration_sensor, 6},
                {robot_farmap, 2},
                {robot_nearmap, 2},
                {robot_imu, 2},
                {robot_lidar, 2},
                {robot_odometry, 2}
            ]}
        ]},
        {floor2,
        [
            {role, publisher_only},
            {devices,
            [
                {machine_temperature_sensor, 6},
                {machine_speed_sensor, 6},
                {machine_energy_consumption, 6},
                {production_quality_sensor, 6},
                {vibration_sensor, 6},
                {robot_farmap, 2},
                {robot_nearmap, 2},
                {robot_imu, 2},
                {robot_lidar, 2},
                {robot_odometry, 2}
            ]}
        ]},
        {sub_quality_assurance,     [{role, subscriber}, {devices, []}]},
        {sub_maintenance_predictive,[{role, subscriber}, {devices, []}]},
        {sub_maintenance_routine,   [{role, subscriber}, {devices, []}]},
        {sub_operations_forecast,   [{role, subscriber}, {devices, []}]},
        {sub_regulatory_reporting,  [{role, subscriber}, {devices, []}]},
        {sub_vendor_maintenance,    [{role, subscriber}, {devices, []}]}
    ]}
].
